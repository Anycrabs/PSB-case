# Скопируйте в .env и заполните отмеченные строки. Файл .env в git не коммитится.

# ===== Языковая модель (OpenAI-совместимый API) =====
# Вне платформы прокси организаторов недоступен: нужен свой ключ DeepSeek (platform.deepseek.com).
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=                      # <-- ЗАПОЛНИТЬ
LLM_MODEL=deepseek-flash          # на платформе модель передаётся автоматически (deepseek/deepseek-v4.1-flash)



# ===== Эмбеддинги BAAI/bge-m3 =====
# local  — модель в контейнерах embedder/indexer (скачивается автоматически при первом запуске)
# remote — POST {LLM_BASE_URL}/embeddings (так работает сабмит на платформе)
# fake   — без модели, только для отладки интерфейса
EMBEDDER_MODE=local
EMB_MODEL=BAAI/bge-m3

# ===== Реранкер =====
# Пусто — без реранжирования. На платформе модель приходит в RERANKER_MODEL, запрос идёт на {LLM_BASE_URL}/rerank.
RERANKER_MODEL=

# LLM_BASE_URL=http://fake-llm:9000/v1
# LLM_API_KEY=fake
# LLM_MODEL=fake
# EMBEDDER_MODE=fake

# ===== Конвейер =====
# fast — 1 вызов LLM на вопрос; auto — + проверка ответа (по умолчанию); full — + разбор вопроса
PIPELINE_MODE=auto
TEMPERATURE=0
MAX_WORKERS=4

# ===== PostgreSQL (история диалогов) =====
# Значения по умолчанию подходят для локального стенда; для общего сервера задайте свой пароль.
# POSTGRES_DB=legal
# POSTGRES_USER=legal
# POSTGRES_PASSWORD=legal

# ===== Docker Compose =====
# Архив базы знаний внутри папки data/
KB_PATH=knowledge-base.zip
