# ===== РљРѕРЅРІРµР№РµСЂ =====
# fast вЂ” 1 РІС‹Р·РѕРІ LLM РЅР° РІРѕРїСЂРѕСЃ; auto вЂ” + РїСЂРѕРІРµСЂРєР° РѕС‚РІРµС‚Р° (РїРѕ СѓРјРѕР»С‡Р°РЅРёСЋ); full вЂ” + СЂР°Р·Р±РѕСЂ РІРѕРїСЂРѕСЃР°
PIPELINE_MODE=auto
TEMPERATURE=0
MAX_WORKERS=4

